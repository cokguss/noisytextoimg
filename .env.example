# Salin jadi .env untuk jalan lokal. JANGAN isi nilai asli di file yg di-push.
# Lokal: cp .env.example .env  (lalu isi)
# Vercel: Project Settings → Environment Variables (isi nama yg sama)
LIVE3D_APP_ID=
LIVE3D_U_ID=
LIVE3D_FN_NAME=
LIVE3D_BRAND_KEY=
LIVE3D_THEME_VERSION=
